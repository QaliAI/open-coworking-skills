# Credentials and environment
.env
.env.*
!.env.example
*.pem
*.key
credentials*.json
secrets*

# Real customer data must never enter this repo.
# Any file matching these patterns is treated as a real export.
*-real-export.*
real-data/
customer-data/
private/

# Paid consulting engagements (the Coworking Revenue & Operations Health Check).
# A client engagement holds real member data and must never be committed; the
# directory layout convention is documented in engagements/README.md, which is
# the only tracked file in there.
engagements/*
!engagements/README.md
clients/

# Temporary exports and working files
*.tmp
*.bak
~$*
output/
out/

# Research clones (inspect only, never commit)
.research/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.venv-audit/
.venv-report/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Node (only if tooling is added later)
node_modules/

# IDE / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Generated platform packages (reproducible from canonical skills)
packages/generated/

# Local Claude Code session settings
.claude/settings.local.json
